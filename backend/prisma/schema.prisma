generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships             Membership[]
  teamMemberships         TeamMember[]
  createdRelationships    Relationship[]
  createdIncidents        Incident[]
  sentOrganizationInvites OrganizationInvitation[] @relation("OrganizationInvitationInvitedBy")
  organizationJoinRequests OrganizationJoinRequest[]
  createdOrganizations    Organization[] @relation("OrganizationCreator")
  conversationMemberships ConversationMember[]
  sentMessages             Message[]
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  joinCode    String   @unique
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User?       @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships   Membership[]
  teams         Team[]
  entities      Entity[]
  relationships Relationship[]
  incidents     Incident[]
  invitations   OrganizationInvitation[]
  joinRequests   OrganizationJoinRequest[]
  conversations  Conversation[]

  @@index([createdById])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members TeamMember[]
  conversation Conversation?

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String   @default("MEMBER")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model EntityType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entities Entity[]
}

model Entity {
  id             String   @id @default(uuid())
  organizationId String
  entityTypeId   String
  name           String
  description    String?
  criticality    String   @default("MEDIUM")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType   EntityType   @relation(fields: [entityTypeId], references: [id])

  outgoingRelationships Relationship[] @relation("SourceRelationships")
  incomingRelationships Relationship[] @relation("TargetRelationships")

  incidents Incident[]

  @@index([organizationId])
  @@index([entityTypeId])
  @@index([criticality])
}

model Relationship {
  id               String   @id @default(uuid())
  organizationId   String
  sourceEntityId   String
  targetEntityId   String
  relationshipType String
  createdById      String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceEntity Entity @relation("SourceRelationships", fields: [sourceEntityId], references: [id], onDelete: Cascade)

  targetEntity Entity @relation("TargetRelationships", fields: [targetEntityId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
}

model Incident {
  id               String @id @default(uuid())
  organizationId   String
  affectedEntityId String
  createdById      String

  title       String
  description String?
  severity    String  @default("MEDIUM")
  status      String  @default("OPEN")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affectedEntity Entity       @relation(fields: [affectedEntityId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  conversation   Conversation?

  @@index([organizationId])
  @@index([affectedEntityId])
  @@index([status])
  @@index([severity])
}

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String
  invitedById    String
  email          String
  role           String    @default("MEMBER")
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrganizationInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
}


model EmailVerificationOTP {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  passwordHash     String
  codeHash         String
  expiresAt        DateTime
  resendAvailableAt DateTime
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([expiresAt])
}

model OrganizationJoinRequest {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  status         String   @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
}

model Conversation {
  id             String   @id @default(uuid())
  organizationId String
  type           String
  title          String?
  directKey      String?
  teamId         String?  @unique
  incidentId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incident     Incident?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  members      ConversationMember[]
  messages     Message[]

  @@unique([organizationId, directKey])
  @@index([organizationId, updatedAt])
  @@index([teamId])
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  senderId        String
  content         String
  clientMessageId String?
  createdAt       DateTime @default(now())
  editedAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
}
