generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  teamMemberships      TeamMember[]
  createdRelationships Relationship[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  teams         Team[]
  entities      Entity[]
  relationships Relationship[]
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members TeamMember[]

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model EntityType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entities Entity[]
}


model Entity {
  id             String   @id @default(uuid())
  organizationId String
  entityTypeId   String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType   EntityType   @relation(fields: [entityTypeId], references: [id])

  outgoingRelationships Relationship[] @relation("SourceRelationships")
  incomingRelationships Relationship[] @relation("TargetRelationships")

  @@index([organizationId])
  @@index([entityTypeId])
}

model Relationship {
  id               String   @id @default(uuid())
  organizationId   String
  sourceEntityId   String
  targetEntityId   String
  relationshipType String
  createdById      String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceEntity Entity @relation("SourceRelationships", fields: [sourceEntityId], references: [id], onDelete: Cascade)

  targetEntity Entity @relation("TargetRelationships", fields: [targetEntityId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
}