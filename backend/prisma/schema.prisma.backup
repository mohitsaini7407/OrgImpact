generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           Membership[]
  teamMemberships       TeamMember[]
  createdRelationships  Relationship[]
  createdIncidents      Incident[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  teams         Team[]
  entities      Entity[]
  relationships Relationship[]
  incidents     Incident[]
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  members TeamMember[]

  @@unique([organizationId, slug])
}

model TeamMember {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model EntityType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  entities Entity[]
}


model Entity {
  id             String   @id @default(uuid())
  organizationId String
  entityTypeId   String
  name           String
  description    String?
  criticality    String   @default("MEDIUM")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType   EntityType   @relation(fields: [entityTypeId], references: [id])

  outgoingRelationships Relationship[] @relation("SourceRelationships")
  incomingRelationships Relationship[] @relation("TargetRelationships")

  incidents Incident[]

  @@index([organizationId])
  @@index([entityTypeId])
  @@index([criticality])
}

model Relationship {
  id               String   @id @default(uuid())
  organizationId   String
  sourceEntityId   String
  targetEntityId   String
  relationshipType String
  createdById      String?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceEntity Entity @relation("SourceRelationships", fields: [sourceEntityId], references: [id], onDelete: Cascade)

  targetEntity Entity @relation("TargetRelationships", fields: [targetEntityId], references: [id], onDelete: Cascade)

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([relationshipType])
}

model Incident {
  id               String   @id @default(uuid())
  organizationId   String
  affectedEntityId String
  createdById      String

  title            String
  description      String?
  severity         String   @default("MEDIUM")
  status           String   @default("OPEN")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  resolvedAt       DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affectedEntity Entity       @relation(fields: [affectedEntityId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([affectedEntityId])
  @@index([status])
  @@index([severity])
}